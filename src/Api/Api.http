# Requests for trying the API by hand (Visual Studio, Rider or VS Code REST Client).
# Start the Api first; named requests (# @name) pass ids on to the ones below them, so run them top to bottom.
# The searches return an array; Visual Studio rejects `$[0].id`, but `$.id` takes the first result's id (limit=1).
@Api = http://localhost:5030

### Find ingredients for the recipe
# @name flour
GET {{Api}}/api/catalog/ingredients?search=buzaliszt&limit=1

###
# @name egg
GET {{Api}}/api/catalog/ingredients?search=tojas&limit=1

###
# @name oil
GET {{Api}}/api/catalog/ingredients?search=olivaolaj&limit=1

### Create a recipe: grams, tablespoons and pieces
# @name created
POST {{Api}}/api/recipes
Content-Type: application/json

{
  "title": "Nokedli",
  "servings": 4,
  "steps": ["Mix the flour, eggs and water into a soft dough.", "Press it into boiling salted water."],
  "tags": ["Köret", "magyar"],
  "ingredients": [
    { "ingredientId": "{{flour.response.body.$.id}}", "amount": 250, "unit": "Gram" },
    { "ingredientId": "{{egg.response.body.$.id}}", "amount": 3, "unit": "Piece" },
    { "ingredientId": "{{oil.response.body.$.id}}", "amount": 1, "unit": "Tablespoon", "note": "for the pan" }
  ]
}

### List, optionally filtered by title (case and accents don't matter)
GET {{Api}}/api/recipes?search=NOKEDLI

### Details with nutrition per serving
GET {{Api}}/api/recipes/{{created.response.body.$.id}}

### Replace it: more servings, no oil
PUT {{Api}}/api/recipes/{{created.response.body.$.id}}
Content-Type: application/json

{
  "title": "Nokedli",
  "servings": 6,
  "steps": ["Mix the flour, eggs and water into a soft dough.", "Press it into boiling salted water."],
  "tags": ["köret"],
  "ingredients": [
    { "ingredientId": "{{flour.response.body.$.id}}", "amount": 375, "unit": "Gram" },
    { "ingredientId": "{{egg.response.body.$.id}}", "amount": 4, "unit": "Piece" }
  ]
}

### Validation: pieces of flour have no weight, servings must be at least 1
POST {{Api}}/api/recipes
Content-Type: application/json

{
  "title": "Broken",
  "servings": 0,
  "steps": [],
  "tags": [],
  "ingredients": [
    { "ingredientId": "{{flour.response.body.$.id}}", "amount": 2, "unit": "Piece" },
    { "ingredientId": "00000000-0000-0000-0000-000000000001", "amount": 1, "unit": "Gram" }
  ]
}

### Meal plan: a week is addressed by its Monday; a week with nothing planned is an empty plan, not a 404
@Week = 2026-11-16
GET {{Api}}/api/plans/{{Week}}

### Put the recipe on Wednesday's lunch (days[2]): title and kcal per serving are copied from Recipes
# @name planned
POST {{Api}}/api/plans/{{Week}}/entries
Content-Type: application/json

{ "recipeId": "{{created.response.body.$.id}}", "day": "Wednesday", "meal": "Lunch", "servings": 2 }

### Move it to Friday's dinner with 3 servings; the daily totals follow
PUT {{Api}}/api/plans/{{Week}}/entries/{{planned.response.body.$.days[2].entries[0].id}}
Content-Type: application/json

{ "day": "Friday", "meal": "Dinner", "servings": 3 }

### Validation: not a Monday, unknown recipe, no servings
POST {{Api}}/api/plans/2026-11-17/entries
Content-Type: application/json

{ "recipeId": "00000000-0000-0000-0000-000000000001", "day": "Monday", "meal": "Lunch", "servings": 0 }

### Take it off the plan
DELETE {{Api}}/api/plans/{{Week}}/entries/{{planned.response.body.$.days[2].entries[0].id}}

### Delete the recipe
DELETE {{Api}}/api/recipes/{{created.response.body.$.id}}
