{
  "openapi": "3.1.1",
  "info": {
    "title": "Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/catalog/ingredients": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Search ingredients by English or Hungarian name",
        "operationId": "SearchIngredients",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Part of the English or Hungarian name; case and accents don't matter.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results, 1 to 50 (default 20).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IngredientSummary"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/recipes": {
      "get": {
        "tags": [
          "Recipes"
        ],
        "summary": "List recipes with energy per serving, optionally filtered by title",
        "operationId": "ListRecipes",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Part of the title; case and accents don't matter. Omit to list every recipe.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecipeSummary"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Recipes"
        ],
        "summary": "Create a recipe",
        "operationId": "CreateRecipe",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/recipes/{id}": {
      "get": {
        "tags": [
          "Recipes"
        ],
        "summary": "Get a recipe with its ingredients and nutrition",
        "operationId": "GetRecipe",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "put": {
        "tags": [
          "Recipes"
        ],
        "summary": "Replace a recipe, ingredient lines included",
        "operationId": "UpdateRecipe",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Recipes"
        ],
        "summary": "Delete a recipe",
        "operationId": "DeleteRecipe",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "IngredientSummary": {
        "required": [
          "id",
          "name",
          "hungarianName",
          "nutrientsPer100g",
          "densityGramsPerMl",
          "pieceWeightGrams"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "hungarianName": {
            "type": "string"
          },
          "nutrientsPer100g": {
            "$ref": "#/components/schemas/NutrientsResponse"
          },
          "densityGramsPerMl": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "pieceWeightGrams": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          }
        }
      },
      "NutrientsResponse": {
        "required": [
          "energyKcal",
          "protein",
          "carbohydrate",
          "fat",
          "fiber"
        ],
        "type": "object",
        "properties": {
          "energyKcal": {
            "type": "number",
            "format": "double"
          },
          "protein": {
            "type": "number",
            "format": "double"
          },
          "carbohydrate": {
            "type": "number",
            "format": "double"
          },
          "fat": {
            "type": "number",
            "format": "double"
          },
          "fiber": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "NutritionResponse": {
        "required": [
          "energyKcal",
          "protein",
          "carbohydrate",
          "fat",
          "fiber"
        ],
        "type": "object",
        "properties": {
          "energyKcal": {
            "type": "number",
            "format": "double"
          },
          "protein": {
            "type": "number",
            "format": "double"
          },
          "carbohydrate": {
            "type": "number",
            "format": "double"
          },
          "fat": {
            "type": "number",
            "format": "double"
          },
          "fiber": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "RecipeDetails": {
        "required": [
          "id",
          "title",
          "servings",
          "steps",
          "tags",
          "ingredients",
          "nutritionPerServing",
          "nutritionTotal"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "servings": {
            "type": "integer",
            "format": "int32"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipeIngredientResponse"
            }
          },
          "nutritionPerServing": {
            "$ref": "#/components/schemas/NutritionResponse"
          },
          "nutritionTotal": {
            "$ref": "#/components/schemas/NutritionResponse"
          }
        }
      },
      "RecipeIngredientRequest": {
        "required": [
          "ingredientId",
          "amount",
          "unit"
        ],
        "type": "object",
        "properties": {
          "ingredientId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RecipeIngredientResponse": {
        "required": [
          "id",
          "ingredientId",
          "name",
          "hungarianName",
          "amount",
          "unit",
          "note"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ingredientId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "hungarianName": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RecipeRequest": {
        "required": [
          "title",
          "servings",
          "steps",
          "tags",
          "ingredients"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "servings": {
            "type": "integer",
            "format": "int32"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipeIngredientRequest"
            }
          }
        }
      },
      "RecipeSummary": {
        "required": [
          "id",
          "title",
          "servings",
          "tags",
          "energyKcalPerServing"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "servings": {
            "type": "integer",
            "format": "int32"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "energyKcalPerServing": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Unit": {
        "enum": [
          "Gram",
          "Kilogram",
          "Milliliter",
          "Liter",
          "Teaspoon",
          "Tablespoon",
          "Cup",
          "Piece"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Catalog"
    },
    {
      "name": "Recipes"
    }
  ]
}